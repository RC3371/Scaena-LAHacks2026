# ASI-1 Mini API (https://api.asi1.ai)
ASI1_API_KEY=your_asi1_api_key_here
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1-mini

# Agentverse
AGENTVERSE_API_KEY=your_agentverse_api_key_here

# Live market research sources
# Gemini grounding can power Google Search discovery without a Programmable Search Engine ID.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GROUNDING_MODEL=gemini-2.5-flash

# Optional fallback/direct source APIs.
# Google Programmable Search powers Google, Peerspace, Instagram/TikTok/Facebook public-page discovery.
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_programmable_search_engine_id_here
EVENTBRITE_API_TOKEN=your_eventbrite_private_token_here
MARKET_RESEARCH_MAX_RESULTS=12

# Agent seed phrases (unique per agent)
AGENT1_SEED=scaena-market-research-agent-2026-la-hacks
AGENT2_SEED=scaena-outreach-pitching-agent-2026-la-hacks
AGENT3_SEED=scaena-analytics-learning-agent-2026-la-hacks
AGENT4_SEED=scaena-pipeline-rebook-agent-2026-la-hacks

# Agent addresses (for real uAgents deployments; simulation mode uses built-ins)
AGENT1_ADDRESS=agent1qscaenamarketresearch
AGENT2_ADDRESS=agent1qscaenaoutreachpitching
AGENT3_ADDRESS=agent1qscaenaanalyticslearning
AGENT4_ADDRESS=agent1qscaenapipelinerebook

# Backend
DATABASE_URL=sqlite:///./scaena.db
BACKEND_URL=http://localhost:8000
SCAENA_SEED_DEMO=false

# Frontend
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Gmail API / real email sending
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/oauth2callback
GMAIL_LIVE_SENDS=false
GMAIL_TEST_RECIPIENT=
EMAIL_ALLOWLIST=
